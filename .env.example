# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.

# ── Supabase (Project Settings -> API) ────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── /admin login (pick your own values — this IS the password) ───────────
ADMIN_ID=ujesh2024
ADMIN_PASSWORD=change-me
# Any long random string — used to sign the admin session cookie.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ── Email notifications for new meeting/freelance requests (optional) ────
# Get a free API key at https://resend.com
RESEND_API_KEY=
NOTIFY_EMAIL=ujeshyadav007@gmail.com
NOTIFY_FROM_EMAIL=Portfolio <onboarding@resend.dev>
