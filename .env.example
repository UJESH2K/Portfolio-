# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets.
#
# No database: /edit logs in with the fixed ID and password in lib/auth.ts,
# and saves by committing content/site.json to the GitHub repo.

# ── /edit saving (required in production) ───────────────────────────────
# A fine-grained GitHub token with "Contents: read and write" on the repo.
GITHUB_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────
# Any long random string to sign the /edit session cookie. If unset, a key
# derived from GITHUB_TOKEN is used.
ADMIN_SESSION_SECRET=
